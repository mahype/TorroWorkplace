{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent/issue-context.mjs\" claude",
            "timeout": 30,
            "statusMessage": "Lade Issue-Kontext"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent/skill-phase.mjs\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "enon-ai-tooling": {
      "source": {
        "source": "github",
        "repo": "Immoticket24/enon-ai-tooling"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "enon-tools@enon-ai-tooling": true
  }
}
