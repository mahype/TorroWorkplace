                "TODO-sha256-of-the-zip"
            ]
        }
    },
    "bin": "torrocalendar.exe",
    "shortcuts": [
        [
            "torrocalendar.exe",
            "Torro Calendar"
        ]
    ],
    "checkver": {
        "github": "https://github.com/mahype/TorroWorkplace"
