# systemd user unit for the packaged TorroWorkplace core (installed to /usr/lib/systemd/user/).
# Enable with: systemctl --user enable --now torroworkplace
# For a manual install from a tarball see integrations/hyprland/torroworkplace.service.

[Unit]
Description=TorroWorkplace core
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/torroworkplace daemon
Restart=on-failure
# Stop and restart end the service only, not the apps it started: they run in its cgroup, and the default
# (control-group) would close them with it, unsaved input included (issue #1001).
KillMode=process

[Install]
WantedBy=graphical-session.target
